;; Shop-floor future bounce at 128 BPM in D major, about three minutes. An original sing-along
;; hook starts as a thin in-store jingle from a small speaker, turns into EDM a layer at a time,
;; and the speaker jingle comes back on top of each drop, then has the last word.
{:groove/format 2
 :globals {:tempo 128 :root :d :scale :major :kit :kit/tr909}
 :instruments
 {:market/music-box {:base :synth/keys :gain 0.3 :cutoff 1400.0 :decay 0.4 :delay 0.0 :reverb 0.15}}
 :defs
 {:market/hook [:notes {:inst :synth/lead :octave 4}
                [[:e 7 :s 7 9 :e 7 4 :q 2 :e 4 :_]
                 [:e 8 :s 8 6 :e 8 11 :q 8 :e 6 :_]
                 [:e 9 :s 9 11 :e 9 7 :q 5 :e 7 :_]
                 [:q 7 :e 5 3 :h 5]]]
  :market/jingle [:market/hook {:inst :synth/speaker}]
  :market/store-chords [:fx [:struct "x... x... x... x..."] [:prog/axis {:inst :market/music-box :octave 3}]]
  :market/chime [:market/hook {:inst :synth/keys :octave 5 :vel 0.5 :delay 0.8}]
  :market/saw [:market/hook {:inst :synth/supersaw :octave 4 :vel 0.55}]
  :market/stabs [:fx [:struct "..x. ..x. ..x. ..x."]
                 [:prog/axis {:inst :synth/supersaw :octave 4 :vel 0.5 :gate 0.4}]]
  :market/pad [:prog/axis {:octave 3 :vel 0.45}]
  :market/arp [:arp/axis {:octave 5 :vel 0.35}]
  :market/octaves [:fx [:struct "x.x. x.x. x.x. x.x."]
                   [:notes {:inst :synth/bass :gate 0.5}
                    [[:e 0 7 0 7 0 7 0 7] [:e 4 11 4 11 4 11 4 11]
                     [:e 5 12 5 12 5 12 5 12] [:e 3 10 3 10 3 10 3 10]]]]
  :market/soft-kick [:beat/four-floor {:vel 0.55}]
  :market/claps [:steps {:inst :cp :vel 0.5 :reverb 0.5} "x... x... x... x..."]
  :market/roll [:fill/snare-roll {:if :fill}]
  :market/crash [:fill/crash {:if :1st}]}
 :sections
 {:store {:jingle :market/jingle :chords :market/store-chords}
  :warm {:base :store :kick :market/soft-kick
         :hats [:steps {:inst :hh :vel 0.25} "..x. ..x. ..x. ..x."]}
  :grow {:base :warm :jingle [:market/jingle {:hp [:ramp 700.0 150.0 8] :cutoff [:ramp 2600.0 6000.0 8]}]
         :bass :market/octaves :claps [:steps {:inst :cp :vel 0.4} ".... x... .... x..."]
         :pad [:market/pad {:cutoff [:ramp 400.0 2500.0 8]}]}
  :build {:pad [:market/pad {:cutoff [:ramp 600.0 5000.0 8]}] :chime :market/chime
          :arp [:market/arp {:cutoff [:ramp 400.0 7000.0 8]}]
          :claps :market/claps :roll :market/roll}
  :drop {:drums :beat/house :bass :market/octaves :stabs :market/stabs :pad :market/pad
         :hook :market/saw :jingle [:market/jingle {:vel 0.9}] :crash :market/crash}
  :aisle {:jingle :market/jingle :chords :market/store-chords :pad [:market/pad {:vel 0.3}]
          :roll :market/roll}
  :drop2 {:base :drop :lead :market/hook :chime [:market/chime {:octave 6 :vel 0.35}]
          :arp :market/arp}
  :closing {:jingle :market/jingle :chords :market/store-chords}}
 :arrangement [[:store 8] [:warm 8] [:grow 8] [:build 8 {:fill 2}] [:drop 16]
               [:aisle 8 {:fill 1}] [:build 8 {:fill 2}] [:drop2 16] [:closing 4]]}
