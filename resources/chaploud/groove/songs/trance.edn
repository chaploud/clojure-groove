;; Uplifting trance at 138 BPM in G minor. The arpeggio filter opens through the build, a snare
;; roll lifts into the drop, and the second drop answers the first with a higher melody.
{:globals {:tempo 138 :root :g}
 :defs
 {:song/crash [:steps {:inst :cr :kit :kit/tr909} "x..............................................................................................................................."]
  :trance/pad [:prog/epic {:octave 3 :reverb 1.0}]
  :trance/arp [:arp/epic {:octave 5 :vel 0.55}]
  :trance/bass [:notes {:inst :synth/bass :scale :minor} [:s :_ 0 0 0 :_ 0 0 0 :_ 0 0 0 :_ 0 0 0 :_ 5 5 5 :_ 5 5 5 :_ 5 5 5 :_ 5 5 5 :_ 2 2 2 :_ 2 2 2 :_ 2 2 2 :_ 2 2 2 :_ 6 6 6 :_ 6 6 6 :_ 6 6 6 :_ 6 6 6]]
  :trance/drums [:beat/trance {:kit :kit/tr909}]}
 :scenes
 {:intro {:drums :beat/four-floor :arp [:trance/arp {:cutoff 900.0}]}
  :build {:drums nil :pad :trance/pad :arp [:trance/arp {:cutoff [:ramp 400.0 6000.0 8]}]}
  :roll {:roll [:fill/snare-roll {:kit :kit/tr909}]}
  :drop {:roll nil :drums :trance/drums :bass :trance/bass :arp :trance/arp :lead :lead/anthem
         :crash :song/crash}
  :break {:drums nil :bass nil :crash nil :lead [:lead/anthem-high {:inst :synth/pluck :vel 0.6 :delay 1.0}]
          :arp nil}
  :drop2 {:roll nil :drums :trance/drums :bass :trance/bass :arp :trance/arp :lead :lead/anthem-high
          :crash :song/crash}
  :outro {:lead nil :bass nil :pad nil :crash nil}}
 :arrangement [[:intro 8] [:build 7] [:roll 1] [:drop 16] [:break 8] [:build 7] [:roll 1] [:drop2 16] [:outro 8]]}
