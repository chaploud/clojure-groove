;; Uplifting trance at 138 BPM in G minor. The arpeggio filter opens through the build, a snare
;; roll lifts into the drop, and the second drop answers the first with a higher melody.
{:globals {:tempo 138 :root :g :kit :kit/tr909}
 :defs
 {:trance/pad [:prog/epic {:octave 3 :reverb 1.0}]
  :trance/arp [:arp/epic {:octave 5 :vel 0.55}]
  :trance/bass [:fx [:struct ".xxx .xxx .xxx .xxx"] [:prog/epic {:inst :synth/bass :voicing :root}]]
  :trance/crash [:fill/crash {:if :1st}]
  :trance/roll [:fill/snare-roll {:if :fill}]}
 :sections
 {:intro {:drums :beat/four-floor :arp [:trance/arp {:cutoff 900.0}]}
  :build {:pad :trance/pad :arp [:trance/arp {:cutoff [:ramp 400.0 6000.0 8]}] :roll :trance/roll}
  :drop {:drums :beat/trance :bass :trance/bass :pad :trance/pad :arp :trance/arp
         :lead :lead/anthem :crash :trance/crash}
  :break {:pad :trance/pad :lead [:lead/anthem-high {:inst :synth/pluck :vel 0.6 :delay 1.0}]}
  :drop2 {:base :drop :lead :lead/anthem-high}
  :outro {:base :drop :bass nil :lead nil :pad nil :crash nil}}
 :arrangement [[:intro 8] [:build 8 {:fill 1}] [:drop 16] [:break 8] [:build 8 {:fill 1}]
               [:drop2 16] [:outro 8]]}
