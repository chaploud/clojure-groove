;; Deep house at 122 BPM in F minor: minor-seventh stabs walk i7-VImaj7-iv7-v7 over a swung beat,
;; the bass follows the roots, and a call-and-answer melody arrives for the second half.
{:globals {:tempo 122 :root :f :scale :minor :kit :kit/tr909 :swing 0.12}
 :defs
 {:house/stabs [:fx [:struct [:steps {:step 1/8} ".x.x ...x"]]
                [:prog/deep-house {:inst :synth/keys :octave 4 :reverb 0.5 :delay 0.4}]]
  :house/bass [:fx [:struct [:steps {:step 1/8} "x..x .x.."]] [:prog/deep-house {:inst :synth/bass :voicing :root}]]
  :house/lead [:lead/call-response {:inst :synth/keys :octave 5 :vel 0.5 :delay 0.8}]}
 :sections
 {:intro {:drums :beat/four-floor :hats [:steps {:inst :hh :vel 0.3} "xxxx xxxx xxxx xxXx"]}
  :groove {:drums :beat/deep-house :bass :house/bass}
  :stabs {:base :groove :stabs :house/stabs :crash [:fill/crash {:if :1st}]}
  :break {:stabs [:house/stabs {:cutoff [:lfo :sine 8 400.0 2200.0]}] :lead :house/lead}
  :main {:base :stabs :lead :house/lead}
  :outro {:base :groove}}
 :arrangement [[:intro 8] [:groove 8] [:stabs 16] [:break 8] [:main 16] [:outro 8]]}
