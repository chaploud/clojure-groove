;; Drum and bass at 174 BPM written in mini-notation: a two-step break and a moving reese.
{:globals {:tempo 174 :root :d :scale :minor}
 :tracks
 {:break [:cycle "[bd ~ ~ ~] [sd ~ ~ ~] [~ ~ bd ~] [sd ~ ~ ~], hh*8?0.2"]
  :ghost [:cycle {:vel 0.3} "~ [~ sd] ~ [sd ~]"]
  :reese [:cycle {:inst :synth/reese :octave 1} "<0 0 -2 -3>"]
  :pad [:cycle {:inst :synth/pad :octave 4 :vel 0.5} "<[0,2,4] [-2,0,2] [-4,-2,1] [-3,-1,1]>"]}}
